OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TELEGRAM_BOT_TOKEN=

# Publishing generated site repository. Leave empty for local-only runs.
PUBLISH_REMOTE_URL=
PUBLIC_REPO_URL=
PUBLISH_BRANCH=gh-pages

# Telegram -> Codex inbox.
TELEGRAM_QUEUE_PATH=.codex/inbox/telegram_jobs.json
TELEGRAM_INBOX_GIT_SYNC=false
TELEGRAM_INBOX_GIT_REMOTE=origin
TELEGRAM_INBOX_GIT_BRANCH=main
TELEGRAM_INBOX_GIT_USER_NAME=website-agent-bot
TELEGRAM_INBOX_GIT_USER_EMAIL=website-agent-bot@example.local

# Runtime behavior.
RUNS_DIR=runs
MAX_FIX_ITERATIONS=5
SEND_VERBOSE_TELEGRAM_LOGS=false
