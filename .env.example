# Local Codex/generation only. Do not set these in Railway bot-only runtime.
LLM_PROVIDER=codex
CODEX_COMMAND=codex
CODEX_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
RESEARCH_STRATEGIST_PROVIDER=openai
DESIGN_DIRECTOR_PROVIDER=openai
SITE_BUILDER_PROVIDER=codex
TELEGRAM_BOT_TOKEN=

# Local Codex publishing only. Never copy these credentials to Railway.
HOSTING_PROVIDER=cloudflare_pages
PUBLISH_REQUIRED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main
CLOUDFLARE_PROJECT_PREFIX=siteagent
CLOUDFLARE_WRANGLER_PACKAGE=wrangler@4
CLOUDFLARE_COMMAND_TIMEOUT_SECONDS=300
CLOUDFLARE_LIVE_RETRIES=5
CLOUDFLARE_LIVE_BACKOFF_SECONDS=2
CLOUDFLARE_LIVE_TIMEOUT_SECONDS=15

# Deprecated explicit Git publisher. Used only with HOSTING_PROVIDER=git.
PUBLISH_REMOTE_URL=
PUBLIC_REPO_URL=
PUBLISH_BRANCH=gh-pages

# Telegram -> Codex inbox.
TELEGRAM_QUEUE_PATH=.codex/inbox/telegram_jobs.json
TELEGRAM_INBOX_GIT_SYNC=false
TELEGRAM_INBOX_GIT_REMOTE=origin
TELEGRAM_INBOX_GIT_REMOTE_URL=
TELEGRAM_INBOX_GIT_BRANCH=main
TELEGRAM_INBOX_GIT_USER_NAME=website-agent-bot
TELEGRAM_INBOX_GIT_USER_EMAIL=website-agent-bot@example.local

# Runtime behavior.
RUNS_DIR=runs
MAX_FIX_ITERATIONS=5
SITE_BUILDER=codex_studio
CREATIVE_STUDIO_HUMAN_CALIBRATION_REQUIRED=true

# Local media preparation only. These values never belong in Railway.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
MEDIA_INPUT_DIR=media_input
SEND_VERBOSE_TELEGRAM_LOGS=false
