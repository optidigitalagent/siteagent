<!doctype html>
<html lang="{{ spec.language | default('en') }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ spec.title }}</title><meta name="description" content="{{ spec.meta_description }}"><meta name="siteagent-business-id" content="{{ siteagent_business_id }}">
  <style>
    :root { --ink:{{ design_tokens.get('ink','#151515') }}; --paper:{{ design_tokens.get('paper','#fbfaf7') }}; --accent:{{ design_tokens.get('accent','#8e3f2d') }}; --accent-2:{{ design_tokens.get('accent_2','#315c55') }}; --line:color-mix(in srgb,var(--ink) 16%,transparent); --radius:{{ design_tokens.get('radius','8px') }}; --max:1160px; }
    *{box-sizing:border-box} html{scroll-behavior:smooth;overflow-x:clip} body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 {{ design_tokens.get('body_font','Inter,system-ui') }};letter-spacing:.005em;overflow-x:clip} img{display:block;max-width:100%;height:auto} a{color:inherit}.skip-link{position:absolute;top:-5rem;left:1rem;padding:.75rem;background:var(--ink);color:white;z-index:20}.skip-link:focus{top:1rem}.site-header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(14px)}.nav{width:min(calc(100% - 2rem),var(--max));min-height:4.25rem;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:1rem}.brand{font-weight:800;max-width:35ch}.nav-type-folio-index-nav .nav{border-left:4px solid var(--accent);padding-left:.8rem}.nav-actions{display:flex;gap:.6rem;align-items:center}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.65rem 1rem;border:1px solid var(--ink);border-radius:var(--radius);font-weight:750;text-decoration:none}.btn.primary{background:var(--ink);color:white}.btn.secondary{background:transparent}.section{border-top:1px solid var(--line)}.inner{width:min(calc(100% - 2rem),var(--max));margin:auto;padding:clamp(3rem,7vw,7rem) 0}.eyebrow{margin:0 0 .8rem;color:var(--accent-2);font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}h1,h2{font-family:{{ design_tokens.get('display_font','Georgia,serif') }};line-height:.98;letter-spacing:-.035em;margin:0}h1{font-size:clamp(3rem,8vw,7.5rem);max-width:10ch}h2{font-size:clamp(2rem,4vw,4rem);max-width:14ch}.lede{font-size:clamp(1.1rem,2vw,1.35rem);max-width:55ch;margin:1.5rem 0}.hero{min-height:min(760px,calc(100svh - 68px));display:grid;align-items:center;gap:clamp(1.5rem,5vw,5rem)}.experience-hero{grid-template-columns:1fr .9fr}.authority-hero{grid-template-columns:.8fr 1.2fr}.portfolio-hero{grid-template-columns:1fr 1.15fr}.outcome-hero{grid-template-columns:1.1fr .8fr}.editorial-sparse-hero{max-width:740px;margin:auto;text-align:center;display:block}.hero-media{min-height:360px;background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 24%,transparent),color-mix(in srgb,var(--accent-2) 18%,transparent));border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.hero-media img{height:100%;width:100%;object-fit:cover}.portfolio-hero .hero-media{border-radius:0}.authority-hero .hero-media{border-radius:50% 50% var(--radius) var(--radius)}.hero-mark{display:grid;place-content:center;height:100%;padding:2rem;font-family:Georgia,serif;font-size:clamp(3rem,10vw,8rem);text-align:center}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:2rem}.signature{display:inline-block;margin-top:1rem;padding:.25rem .65rem;border:1px solid var(--accent);color:var(--accent);font-weight:800;font-size:.78rem;letter-spacing:.09em;text-transform:uppercase}.menu-ribbon{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;background:var(--line)}.menu-ribbon>*{background:var(--paper);padding:1.5rem}.masonry-gallery{columns:3 180px;gap:1rem}.masonry-gallery img{margin:0 0 1rem;border-radius:var(--radius);min-height:150px;object-fit:cover}.proof-strip,.quote-wall{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem}.proof-strip>*{border-top:3px solid var(--accent);padding:1.2rem 0}.question-columns{columns:2 220px;gap:3rem}.question-columns>*{break-inside:avoid;padding:1rem 0;border-bottom:1px solid var(--line)}.service-matrix,.program-stack{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}.service-matrix>* ,.program-stack>*{padding:1.2rem;border:1px solid var(--line);border-radius:var(--radius);background:white}.numbered-timeline,.studio-steps,.benefit-steps{display:grid;gap:0}.numbered-timeline>* ,.studio-steps>* ,.benefit-steps>*{padding:1rem 0 1rem 3rem;border-left:2px solid var(--accent);position:relative}.numbered-timeline>*:before,.studio-steps>*:before,.benefit-steps>*:before{content:counter(step);counter-increment:step;position:absolute;left:-.7rem;top:1rem;width:1.3rem;height:1.3rem;display:grid;place-content:center;background:var(--accent);color:white;border-radius:50%;font-size:.75rem}.numbered-timeline,.studio-steps,.benefit-steps{counter-reset:step}.portfolio-mosaic{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem}.portfolio-mosaic>*:nth-child(3n){grid-column:span 2}.portfolio-mosaic>*{padding:2rem;background:color-mix(in srgb,var(--accent) 8%,var(--paper));min-height:130px}.model-diagram,.platform-frame{padding:clamp(1.5rem,5vw,4rem);border:1px solid var(--line);border-radius:50% 0 50% 0;background:linear-gradient(135deg,transparent,color-mix(in srgb,var(--accent-2) 14%,transparent))}.single-offer{max-width:48rem;border-top:5px solid var(--ink);padding-top:1.2rem}.closure{background:var(--ink);color:white}.closure h2{color:white}.closure .inner{display:grid;grid-template-columns:1fr auto;align-items:center;gap:2rem}.closure .btn{background:white;color:var(--ink);border-color:white}.inquiry-closure{background:var(--accent)}.direct-editorial-closure{background:transparent;color:var(--ink);border-top:4px solid var(--ink)}.direct-editorial-closure h2{color:var(--ink)}.direct-editorial-closure .btn{background:var(--ink);color:white}.footer{width:min(calc(100% - 2rem),var(--max));margin:auto;padding:2rem 0;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:1rem;color:color-mix(in srgb,var(--ink) 62%,transparent)}.footer nav{display:flex;flex-wrap:wrap;gap:.75rem}.footer a{min-width:44px;min-height:44px;display:inline-flex;align-items:center}.content-list{margin:1rem 0 0;padding:0;list-style:none}.content-list li{margin:.8rem 0;overflow-wrap:anywhere}.section-copy{max-width:62ch;margin:1rem 0 0}.journey-intentional-sparse-editorial .site-header{border-bottom:0}@media(max-width:760px){.nav{align-items:flex-start;flex-direction:column;padding:.8rem 0}.nav-actions{width:100%}.nav-actions .btn{flex:1}.hero,.experience-hero,.authority-hero,.portfolio-hero,.outcome-hero{grid-template-columns:1fr;min-height:auto}.hero-media{min-height:260px;order:-1}.portfolio-mosaic{grid-template-columns:1fr}.portfolio-mosaic>*:nth-child(3n){grid-column:auto}.closure .inner{grid-template-columns:1fr}.closure .btn{width:100%}.masonry-gallery{columns:2 140px}.footer{grid-template-columns:1fr}}@media(max-width:420px){.masonry-gallery{columns:1}.hero-actions .btn{width:100%}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
  </style>
</head>
<body class="journey-{{ composition.journey_pattern|replace('/','-')|replace(' ','-') }} nav-type-{{ composition.navigation_type|replace(' ','-') }}">
<a class="skip-link" href="#content">Skip to content</a><header class="site-header"><nav class="nav" aria-label="{{ composition.navigation_type }}"><div class="brand">{{ spec.title }}</div><div class="nav-actions"><a class="btn secondary" href="#details">{{ spec.secondary_cta }}</a><a class="btn primary" data-site-cta="primary" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a></div></nav></header>
<main id="content" data-journey="{{ composition.journey_pattern }}" data-signature="{{ composition.signature_element }}">
{% for item in planned_sections %}{% set p=item.plan %}
  {% if p.type.endswith('hero') %}
  <section id="{{ p.id }}" class="section hero {{ p.type|replace('_','-') }}" data-section-type="{{ p.type }}" data-layout-family="{{ p.layout_family }}"><div><p class="eyebrow">{{ research.niche }}</p><h1>{{ spec.h1 }}</h1><p class="lede">{{ spec.hero_subtitle }}</p><p>@{{ instagram_handle }}</p><span class="signature">{{ composition.signature_element }}</span><div class="hero-actions"><a class="btn primary" data-site-cta="primary" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a><a class="btn secondary" href="#details">{{ spec.secondary_cta }}</a></div></div><div class="hero-media">{% if hero_asset %}<img src="{{ hero_asset }}" alt="{{ spec.h1 }}">{% else %}<div class="hero-mark" aria-hidden="true">{{ (spec.h1 or spec.title)[:1] }}</div>{% endif %}</div></section>
  {% elif p.type.endswith('closure') %}
  <section id="{{ p.id }}" class="section closure {{ p.type|replace('_','-') }}" data-section-type="{{ p.type }}" data-layout-family="{{ p.layout_family }}"><div class="inner"><div><p class="eyebrow">{{ p.visual_role }}</p><h2>{{ item.title }}</h2><p class="section-copy">{{ spec.footer_note }}</p>{% for line in item.content %}<p>{{ line }}</p>{% endfor %}</div><a class="btn" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a></div></section>
  {% else %}
  <section id="{{ p.id }}" class="section {{ p.type|replace('_','-') }}" data-section-type="{{ p.type }}" data-layout-family="{{ p.layout_family }}"><div class="inner"><p class="eyebrow">{{ p.visual_role }}</p><h2>{{ item.title }}</h2><p class="section-copy">{{ p.required_message }}</p>{% if p.type == 'atmosphere_gallery' or p.type == 'portfolio_mosaic' %}<div class="{{ p.layout_family }}">{% if item.gallery %}{% for image in item.gallery %}<img src="{{ image }}" alt="{{ spec.title }} visual {{ loop.index }}" loading="lazy">{% endfor %}{% else %}{% for line in item.content %}<div>{{ line }}</div>{% endfor %}{% endif %}</div>{% else %}<ol class="content-list {{ p.layout_family }}">{% for line in item.content %}<li>{{ line }}</li>{% endfor %}</ol>{% endif %}{% if item.cta %}<p><a class="btn secondary" href="{{ research.instagram_url }}">{{ item.cta }}</a></p>{% endif %}</div></section>
  {% endif %}
{% endfor %}
</main><footer class="footer"><span>{{ spec.title }}</span><nav aria-label="Footer navigation"><a href="#content">Top</a><a href="#details">Details</a></nav><a class="btn primary" data-site-cta="primary" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a></footer></body></html>
