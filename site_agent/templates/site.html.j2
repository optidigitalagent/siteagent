<!doctype html>
<html lang="{{ spec.language | default('en') }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ spec.title }}</title>
  <meta name="description" content="{{ spec.meta_description }}">
  <meta name="siteagent-business-id" content="{{ siteagent_business_id }}">
  <style>
    :root {
      --ink: {{ design_tokens.get('ink', '#151515') }};
      --muted: #5d625f;
      --line: #dedbd4;
      --paper: {{ design_tokens.get('paper', '#fbfaf7') }};
      --panel: #f1eee7;
      --accent: {{ design_tokens.get('accent', '#8e3f2d') }};
      --accent-2: {{ design_tokens.get('accent_2', '#315c55') }};
      --white: #ffffff;
      --radius: {{ design_tokens.get('radius', '8px') }};
      --max: 1120px;
      color-scheme: light;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; } }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height: 1.5;
      letter-spacing: 0;
    }
    img { display: block; max-width: 100%; height: auto; }
    a { color: inherit; }
    .skip-link {
      position: absolute;
      left: 12px;
      top: -80px;
      background: var(--ink);
      color: var(--white);
      padding: 10px 14px;
      z-index: 10;
    }
    .skip-link:focus { top: 12px; }
    .site-header {
      position: sticky;
      top: 0;
      z-index: 5;
      background: rgba(251, 250, 247, 0.92);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(12px);
    }
    .nav {
      width: min(100% - 32px, var(--max));
      margin: 0 auto;
      min-height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .brand {
      font-weight: 760;
      line-height: 1.1;
      max-width: 42ch;
      overflow-wrap: anywhere;
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    .btn {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--ink);
      padding: 11px 16px;
      text-decoration: none;
      font-weight: 700;
      border-radius: var(--radius);
      line-height: 1.15;
      cursor: pointer;
    }
    .btn.primary {
      background: var(--ink);
      color: var(--white);
    }
    .btn.secondary {
      background: transparent;
      color: var(--ink);
    }
    .text-link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-top: 18px;
      padding: 8px 0;
      color: var(--accent-2);
      font-weight: 760;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
    .hero {
      width: min(100% - 32px, var(--max));
      margin: 0 auto;
      min-height: calc(100svh - 64px);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
      gap: clamp(28px, 5vw, 72px);
      align-items: center;
      padding: clamp(34px, 6vw, 76px) 0;
    }
    .eyebrow {
      margin: 0 0 14px;
      color: var(--accent-2);
      font-size: 0.92rem;
      font-weight: 760;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    h1 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.35rem, 8vw, 5.8rem);
      line-height: 0.96;
      letter-spacing: 0;
      max-width: 11ch;
      overflow-wrap: anywhere;
    }
    .hero-copy {
      margin: 24px 0 0;
      max-width: 62ch;
      color: #343835;
      font-size: clamp(1.04rem, 2vw, 1.28rem);
      overflow-wrap: anywhere;
    }
    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }
    .hero-media {
      position: relative;
      aspect-ratio: 4 / 5;
      background: var(--panel);
      overflow: hidden;
      border-radius: var(--radius);
      border: 1px solid var(--line);
    }
    .hero-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-media .fallback {
      height: 100%;
      display: grid;
      place-content: center;
      padding: 28px;
      background:
        linear-gradient(135deg, rgba(142,63,45,0.12), rgba(49,92,85,0.14)),
        var(--panel);
    }
    .journey-trust-journey .hero { grid-template-columns: minmax(260px, 0.7fr) minmax(0, 1fr); }
    .journey-portfolio-proof .hero { grid-template-columns: minmax(0, 0.88fr) minmax(360px, 1.12fr); }
    .journey-expert-authority .hero { align-items: start; padding-top: clamp(72px, 11vw, 150px); }
    .journey-trust-journey .hero-media { border-radius: 50% 50% var(--radius) var(--radius); }
    .journey-portfolio-proof .hero-media { border-radius: 0; transform: rotate(1deg); }
    .journey-expert-authority .hero-media { border-radius: 999px 999px var(--radius) var(--radius); }
    .journey-local-destination .hero-media { border-radius: var(--radius) 72px var(--radius) 72px; }
    .journey-portfolio-proof .content-list li { border-radius: 0; }
    .journey-expert-authority .content-list li { border-left: 5px solid var(--accent); }
    .journey-trust-journey .content-list li { border-color: var(--accent-2); }
    .journey-briefing { margin: -18px auto 0; width: min(100% - 32px, var(--max)); padding: 18px; border: 1px solid var(--line); background: var(--white); }
    .fallback strong {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2rem, 8vw, 4.6rem);
      line-height: 0.95;
    }
    .fallback .profile-card {
      width: min(100%, 320px);
      display: grid;
      gap: 18px;
      color: var(--ink);
    }
    .profile-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .profile-grid span {
      aspect-ratio: 1;
      border-radius: 6px;
      border: 1px solid rgba(21, 21, 21, 0.12);
      background:
        linear-gradient(135deg, rgba(255,255,255,0.76), rgba(142,63,45,0.14)),
        var(--panel);
    }
    .profile-mark {
      width: 78px;
      height: 78px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--white);
      border: 1px solid var(--line);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 2rem;
    }
    .profile-card p {
      margin: 0;
      color: var(--muted);
      font-weight: 650;
    }
    main section {
      border-top: 1px solid var(--line);
    }
    .section-inner {
      width: min(100% - 32px, var(--max));
      margin: 0 auto;
      padding: clamp(42px, 7vw, 86px) 0;
    }
    .split {
      display: grid;
      grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
      gap: clamp(24px, 5vw, 72px);
    }
    h2 {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.75rem, 4vw, 3.15rem);
      line-height: 1.04;
      letter-spacing: 0;
    }
    .section-purpose {
      margin: 14px 0 0;
      color: var(--muted);
      max-width: 34ch;
    }
    .content-list {
      display: grid;
      gap: 14px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .content-list li {
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px 18px;
      font-size: 1rem;
      overflow-wrap: anywhere;
    }
    .plain-list {
      display: grid;
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .plain-list li {
      padding-left: 18px;
      border-left: 3px solid var(--accent);
      overflow-wrap: anywhere;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .gallery-grid img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: var(--radius);
      border: 1px solid var(--line);
      background: var(--panel);
    }
    .cta-band {
      background: var(--ink);
      color: var(--white);
    }
    .cta-band .section-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 24px;
    }
    .cta-band h2 { color: var(--white); max-width: 13ch; }
    .cta-band p { color: #dfdfdc; max-width: 62ch; margin: 14px 0 0; }
    .cta-band .btn {
      border-color: var(--white);
      color: var(--ink);
      background: var(--white);
    }
    .footer {
      width: min(100% - 32px, var(--max));
      margin: 0 auto;
      padding: 28px 0 42px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }
    @media (max-width: 820px) {
      .journey-trust-journey .hero,
      .journey-portfolio-proof .hero,
      .journey-expert-authority .hero { grid-template-columns: 1fr; }
      .journey-portfolio-proof .hero-media { transform: none; }
      .nav {
        align-items: flex-start;
        flex-direction: column;
        padding: 12px 0;
      }
      .nav-actions { width: 100%; justify-content: stretch; }
      .nav-actions .btn { flex: 1 1 150px; }
      .hero {
        min-height: auto;
        grid-template-columns: 1fr;
        padding-top: 30px;
      }
      h1 { max-width: 12ch; }
      .hero-media {
        order: -1;
        aspect-ratio: 16 / 11;
      }
      .split {
        grid-template-columns: 1fr;
      }
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .cta-band .section-inner {
        grid-template-columns: 1fr;
      }
      .cta-band .btn { width: 100%; }
    }
    @media (max-width: 460px) {
      .gallery-grid { grid-template-columns: 1fr; }
      .hero-actions .btn { width: 100%; }
      .content-list li { padding: 16px; }
    }
  </style>
</head>
<body class="{{ niche_class }} journey-{{ journey_pattern | replace(' ', '-') }}">
  <a class="skip-link" href="#content">{{ labels.skip }}</a>
  <header class="site-header">
    <nav class="nav" aria-label="Primary">
      <div class="brand">{% if sparse %}Instagram{% else %}{{ spec.h1 or spec.title }}{% endif %}</div>
      {% if not sparse %}
      <div class="nav-actions">
        <a class="btn secondary" href="#details">{{ spec.secondary_cta }}</a>
        <a class="btn primary" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a>
      </div>
      {% endif %}
    </nav>
  </header>

  <main id="content">
    {% if journey_pattern == 'trust journey' %}
      <aside class="journey-briefing" aria-label="Visit planning">Bring the questions that matter to your first visit.</aside>
    {% elif journey_pattern == 'portfolio proof' %}
      <aside class="journey-briefing" aria-label="Project lens">Start with a material, room, or project question.</aside>
    {% elif journey_pattern == 'expert authority' %}
      <aside class="journey-briefing" aria-label="Learning path">Choose the learning question before choosing a course.</aside>
    {% elif journey_pattern == 'local destination' %}
      <aside class="journey-briefing" aria-label="Today's visit">Plan the next lunch around what is on the table.</aside>
    {% endif %}
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">{{ hero_eyebrow }}</p>
        <h1 id="hero-title">{{ spec.h1 }}</h1>
        <p class="hero-copy">{{ spec.hero_subtitle }}</p>
        <div class="hero-actions">
          <a class="btn primary" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a>
          {% if not sparse %}
          <a class="btn secondary" href="#details">{{ spec.secondary_cta }}</a>
          {% endif %}
        </div>
      </div>
      <div class="hero-media" aria-label="Brand visual">
        {% if hero_asset %}
          <img src="{{ hero_asset }}" alt="{{ spec.h1 or spec.title }}">
        {% else %}
          <div class="fallback">
            <div class="profile-card">
              <div class="profile-mark" aria-hidden="true">{{ (spec.h1 or spec.title)[:1] }}</div>
              <strong>{{ spec.h1 or spec.title }}</strong>
              <p>@{{ instagram_handle }}</p>
              <div class="profile-grid" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
              <p>{{ labels.profile_note | default('Open the Instagram profile and send a Direct message to confirm the details.') }}</p>
            </div>
          </div>
        {% endif %}
      </div>
    </section>

    {% for section in spec.sections %}
      <section id="{{ section.id }}">
        <div class="section-inner split">
          <div>
            <h2>{{ section.title }}</h2>
          </div>
          <div>
            <ul class="content-list">
              {% for item in section.content %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
            {% if section.cta %}
              <p><a class="text-link" href="{{ research.instagram_url }}">{{ section.cta }}</a></p>
            {% endif %}
          </div>
        </div>
      </section>
    {% endfor %}

    {% if gallery %}
      <section id="gallery">
        <div class="section-inner split">
          <div>
            <h2>{{ labels.gallery }}</h2>
            <p class="section-purpose">{{ labels.gallery_purpose }}</p>
          </div>
          <div class="gallery-grid">
            {% for image in gallery %}
              <img src="{{ image }}" alt="{{ spec.h1 or spec.title }} visual {{ loop.index }}" loading="lazy">
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    {% if not sparse %}
    <section id="trust">
      <div class="section-inner split">
        <div>
          <h2>{{ labels.trust }}</h2>
          <p class="section-purpose">{{ labels.trust_purpose }}</p>
        </div>
        <ul class="plain-list">
          {% for point in spec.trust_points %}
            <li>{{ point }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section id="process">
      <div class="section-inner split">
        <div>
          <h2>{{ labels.process }}</h2>
          <p class="section-purpose">{{ labels.process_purpose }}</p>
        </div>
        <ul class="content-list">
          {% for step in spec.process_steps %}
            <li>{{ step }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>
    {% endif %}

    <section id="details">
      <div class="section-inner split">
        <div>
          <h2>{{ labels.contacts }}</h2>
          <p class="section-purpose">{{ labels.contacts_purpose }}</p>
        </div>
        <ul class="plain-list">
          {% for line in spec.contact_lines %}
            <li>{{ line }}</li>
          {% else %}
            <li>{{ labels.contact_fallback }}</li>
          {% endfor %}
        </ul>
      </div>
    </section>

    <section class="cta-band">
      <div class="section-inner">
        <div>
          <h2>{{ spec.primary_cta }}</h2>
          <p>{{ spec.footer_note }}</p>
        </div>
        <a class="btn" href="{{ research.instagram_url }}">{{ spec.primary_cta }}</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    {% if sparse %}
      <span>Instagram</span>
    {% else %}
      <span>{{ spec.h1 or spec.title }}</span>
      <span>{{ spec.footer_note }}</span>
    {% endif %}
  </footer>
</body>
</html>
