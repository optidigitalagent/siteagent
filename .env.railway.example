# Railway runs only the Telegram inbox bot.
# It accepts Instagram links, writes .codex/inbox/telegram_jobs.json,
# pushes that queue to GitHub, and replies:
# Окей, работа запущена.
# Напиши в Codex: го

TELEGRAM_BOT_TOKEN=

TELEGRAM_QUEUE_PATH=.codex/inbox/telegram_jobs.json
TELEGRAM_INBOX_GIT_SYNC=true
TELEGRAM_INBOX_GIT_REMOTE=origin
TELEGRAM_INBOX_GIT_REMOTE_URL=https://x-access-token:<GITHUB_TOKEN>@github.com/optidigitalagent/siteagent.git
TELEGRAM_INBOX_GIT_BRANCH=main
TELEGRAM_INBOX_GIT_USER_NAME=website-agent-bot
TELEGRAM_INBOX_GIT_USER_EMAIL=website-agent-bot@example.local

SEND_VERBOSE_TELEGRAM_LOGS=false
